# Copy this file to .env and fill it in. .env is git-ignored.

# Printer credentials (from the printer screen: Settings -> WLAN / Device).
# LAN Mode must be enabled on the printer.
BAMBU_HOST=192.168.1.60
BAMBU_CODE=12345678
BAMBU_SERIAL=01P00A000000000

# Shared secret between the bridge and ml_api. Use any long random string.
# If this is ever unset, ml_api's auth decorator silently degrades to no
# authentication at all.
ML_API_TOKEN=change-me-to-a-long-random-string
